{
  "expo": {
    "name": "Zaavo",
    "slug": "zaavo-customer",
    "scheme": "zaavocustomer",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#FAF8F5"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zaavo.customer"
    },
    "android": {
      "package": "com.zaavo.customer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#1D4626"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@clerk/expo",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
