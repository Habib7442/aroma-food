{
  "expo": {
    "name": "Zaavo Partner",
    "slug": "zaavo-partner",
    "scheme": "zaavopartner",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#FAF8F5"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zaavo.partner"
    },
    "android": {
      "package": "com.zaavo.partner",
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F5"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@clerk/expo",
      "@react-native-community/datetimepicker",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
