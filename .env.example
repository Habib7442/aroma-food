# Zaavo — environment variable reference (PRD §11)
#
# This file is committed. A filled-in `.env` never is (see .gitignore).
#
# Anything prefixed EXPO_PUBLIC_ or NEXT_PUBLIC_ is inlined into the shipped
# bundle and readable from any APK/webpage. Never put a secret behind those
# prefixes. Server-only keys belong in Supabase Edge Function secrets or the
# admin app's Vercel environment variables — never in app code.

# ── Supabase ──────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server-only — Edge Function / server secrets, never in app code.
# Also what scripts/seed.ts and scripts/test-rls.ts use to reach the
# database (via @supabase/supabase-js / the REST API), together with
# SUPABASE_URL above — no separate DB connection string needed.
SUPABASE_SERVICE_ROLE_KEY=

# ── Clerk ─────────────────────────────────────────────────────────────────
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# server-only
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# ── Razorpay ──────────────────────────────────────────────────────────────
EXPO_PUBLIC_RAZORPAY_KEY_ID=
# server-only
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Cloudflare R2 (all media: menu/category photos, promo banners — see
# PRD §7.5. Sanity was dropped; R2 covers everything, one provider) ────────
# server-only — uploads are signed server-side (r2-presign Edge Function),
# never with a bundled key. R2_PUBLIC_URL isn't secret (r2.dev in
# development; a real custom domain like cdn.zaavo.in before launch) but
# stays server-side too — the Edge Function returns the finished public
# URL directly, so the app never needs to construct one itself.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ── Upstash Redis / QStash ───────────────────────────────────────────────
# server-only — never called directly from the app
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ── Google Maps (restricted by package name + release SHA-1) ─────────────
EXPO_PUBLIC_GOOGLE_MAPS_KEY=

# ── Sentry ─────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
