{
  "name": "zaavo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:push": "supabase db push",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:types": "supabase gen types typescript --linked > packages/database/src/types.ts",
    "db:test-rls": "tsx --env-file=.env scripts/test-rls.ts"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "supabase": "^2.109.1",
    "tsx": "^4.19.0",
    "turbo": "^2.1.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true
  }
}
